{
  "manifestVersion": 5,
  "id": "com.isbd.studio.photoshop",
  "name": "ISBD Studio AI Pro Retouch",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "isbdStudioPanel",
      "name": "ISBD Studio AI",
      "main": "index.html",
      "minimumSize": { "width": 260, "height": 380 },
      "maximumSize": { "width": 450, "height": 800 },
      "preferredDockedSize": { "width": 300, "height": 550 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "http://127.0.0.1:8077",
        "http://localhost:8077",
        "http://192.168.0.100:8077"
      ]
    }
  }
}
